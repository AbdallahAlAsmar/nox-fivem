{
  "productName": "NOX-FiveM",
  "version": "0.1.0",
  "identifier": "com.nox.fivem",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "NOX-FiveM",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/256x256.png",
      "icons/32x32.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": ".*"
    }
  }
}
