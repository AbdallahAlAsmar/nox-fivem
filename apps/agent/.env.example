# Environment variables for the agent
# Copy this to .env and fill in your values

# Server ID and Agent Device ID (from pairing)
AGENT_SERVER_ID=your-server-id
AGENT_DEVICE_ID=your-agent-device-id

# WebSocket URL of the orchestrator
ORCHESTRATOR_WS_URL=ws://localhost:3001/ws/agent

# Path to the FXServer server-data directory
SERVER_DATA_PATH=C:/FXServer/server-data

# Optional: txAdmin integration
# TXADMIN_URL=http://localhost:40120
# TXADMIN_TOKEN=your-txadmin-token

# Optional: RCON for console commands
# RCON_HOST=localhost
# RCON_PORT=30120
# RCON_PASSWORD=your-rcon-password
