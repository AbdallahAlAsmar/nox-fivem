# ============================================
# SHARED
# ============================================

# Environment (development, production, test)
NODE_ENV=development

# ============================================
# DATABASE (Supabase)
# ============================================
# Get these from your Supabase project settings
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ============================================
# AUTH (Clerk)
# ============================================

# Get these from your Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_[YOUR-KEY]
CLERK_SECRET_KEY=sk_test_[YOUR-SECRET]

# Clerk URLs (usually these defaults work)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ============================================
# AI (Anthropic Claude)
# ============================================

# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# ============================================
# ORCHESTRATOR
# ============================================

# Port for the orchestrator HTTP/WebSocket server
ORCHESTRATOR_PORT=3001
ORCHESTRATOR_WS_PORT=3002

# JWT secret for signing pairing tokens (generate a random string)
JWT_SECRET="[GENERATE-A-RANDOM-32+-CHAR-SECRET]"

# Clerk secret key used by the ORCHESTRATOR to verify dashboard bearer tokens.
# Same key as the web app's CLERK_SECRET_KEY.
# If unset, every route requiring authentication returns 401.
CLERK_SECRET_KEY="sk_test_..."

# Browser-facing origin of the dashboard, added to the orchestrator's CORS
# allowlist (useful when the dashboard is deployed on its own domain).
DASHBOARD_ORIGIN="https://your-dashboard.example.com"

# Comma-separated CORS allowlist for the orchestrator. Defaults to
# "http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost"
CORS_ORIGINS="http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost"

# TRANSITIONAL (default true): when true, requests with NO Authorization header
# are treated as an anonymous user bound to the legacy 'dev-org'. Invalid or
# expired tokens are ALWAYS rejected regardless of this flag.
# Flip to false once all clients send bearer tokens.
AUTH_ALLOW_ANON=true

# TRANSITIONAL (default true): when true, agents that paired before session
# tokens existed may still connect without a sessionToken. Flip to false once
# all desktop agents have re-paired.
AGENT_LEGACY_OK=true

# OmniRoute (OpenAI-compatible AI provider) endpoint + key used by the
# orchestrator's chat client (apps/orchestrator/src/claude/session.ts).
OMNIROUTE_BASE_URL="https://your-omniroute-endpoint.example.com/v1"
OMNIROUTE_API_KEY="[YOUR-OMNIROUTE-KEY]"

# Conservative placeholder token-cost rates (USD per 1M input/output tokens)
# used by the orchestrator's cost-cap estimator for the 'Noxes AI' default
# model and any other unmapped model. See apps/orchestrator/src/claude/pricing.ts.
AI_COST_PER_MTOK_IN=3.00
AI_COST_PER_MTOK_OUT=15.00

# WebSocket URL handed to desktop agents at pairing time.
ORCHESTRATOR_WS_URL="ws://localhost:3001/ws/agent"

# ============================================
# WEB DASHBOARD
# ============================================

# Next.js port
PORT=3000

# The orchestrator base URL the BROWSER uses (NEXT_PUBLIC_ so it is inlined at
# build time; lib/config.ts reads this exact name). Leave unset in dev to use
# the /api/orchestrator proxy; set to the orchestrator host for direct calls.
NEXT_PUBLIC_ORCHESTRATOR_URL=""

# ============================================
# REDIS (Optional - for production)
# ============================================

# For local dev, Redis is optional
# REDIS_URL="redis://localhost:6379"

# ============================================
# BILLING (Stripe) - Phase 2
# ============================================

# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ============================================
# ANALYTICS (Optional)
# ============================================

# SENTRY_DSN="..."
# POSTHOG_KEY="..."
