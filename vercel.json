{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "devCommand": "next dev",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/orchestrator/(.*)", "destination": "http://158.101.167.118:3001/$1" },
    { "source": "/clerk.browser.js", "destination": "/clerk.browser.js" },
    { "source": "/dist/:path*", "destination": "/dist/:path*" }
  ]
}
